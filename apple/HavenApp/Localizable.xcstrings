    "Read the most recent direct message from someone in your circle.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルのメンバーから届いた最新のダイレクトメッセージを読み上げます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Direktnachricht von jemandem aus deinem Kreis lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el mensaje directo más reciente de alguien de tu círculo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서클에 있는 사람이 보낸 가장 최근 다이렉트 메시지를 읽어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
