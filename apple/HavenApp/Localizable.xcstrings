    },
    "Keep your primary device (iPhone) nearby or online and confirm the prompt there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインの端末（iPhone）を近くに置くかオンラインにして、そちらで表示される確認に応じてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dein Hauptgerät (iPhone) in der Nähe oder online und bestätige dort die Anfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tu dispositivo principal (iPhone) cerca o conectado y confirma el aviso ahí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 기기(iPhone)를 가까이 두거나 온라인 상태로 두고, 기기에 표시되는 요청을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu dispositivo principal (iPhone) por perto ou on-line e confirme a solicitação nele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni vicino o online il tuo dispositivo principale (iPhone) e conferma la richiesta lì."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre appareil principal (iPhone) à proximité ou en ligne, puis confirmez la demande qui s'y affiche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让你的主设备（iPhone）在身边或保持在线，并在上面确认提示。"
          }
        }
      }
    },
    "Keeping this device too?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末も残しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät auch behalten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Conservar también este dispositivo?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기도 그대로 두시겠어요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter este dispositivo também?"
          }
        },
        "it": {
          "stringUnit": {
