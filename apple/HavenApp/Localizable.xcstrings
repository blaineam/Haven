    "Switch to Custom domain or Manual — free tunnel hostnames won't resolve on this network.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムドメインまたは手動に切り替えてください。このネットワークでは無料トンネルのホスト名を解決できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
