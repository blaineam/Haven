    "Spotlight searches this circle on-device only. Face ID relocks it on each open.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight はこのサークルを端末内でのみ検索します。開くたびに Face ID で再ロックされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight durchsucht diesen Kreis nur auf dem Gerät. Face ID sperrt ihn bei jedem Öffnen wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight busca en este círculo solo en el dispositivo. Face ID lo vuelve a bloquear cada vez que lo abres."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight은 이 서클을 기기 안에서만 검색합니다. 열 때마다 Face ID로 다시 잠깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Spotlight pesquisa este círculo apenas no dispositivo. O Face ID bloqueia o círculo de novo a cada abertura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight cerca in questa cerchia solo sul dispositivo. Face ID la riblocca a ogni apertura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight ne recherche ce cercle que sur cet appareil. Face ID le reverrouille à chaque ouverture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 仅在本机搜索这个圈子。每次打开时 Face ID 都会重新锁定它。"
          }
        }
      }
    },
