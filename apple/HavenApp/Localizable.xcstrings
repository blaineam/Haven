            "state": "translated",
            "value": "读出圈子里某人发来的最新私信。"
          }
        }
      }
    },
    "Read the most recent post, optionally from a specific circle or friend.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の投稿を読み上げます。特定のサークルや友達を指定することもできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
