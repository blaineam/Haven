    "Add a Haven relay by node id, or bring your own S3 bucket as a store-and-forward relay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Haven-Relay per Node-ID hinzu oder nutze deinen eigenen S3-Bucket als Store-and-Forward-Relay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
