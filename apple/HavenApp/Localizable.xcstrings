    "Anyone with this code can become you. Never share it with anyone else, and don't post it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを持っている人は、あなたになりすませます。ほかの人には絶対に共有せず、投稿もしないでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer diesen Code hat, kann sich als du ausgeben. Teile ihn mit niemandem und poste ihn nirgends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que tenga este código puede suplantarte. No lo compartas con nadie ni lo publiques."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드를 가진 사람은 누구나 내가 될 수 있어요. 다른 사람과 절대 공유하지 말고, 어디에도 올리지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com este código pode se passar por você. Nunca compartilhe com ninguém e não publique em lugar nenhum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia questo codice può impersonarti. Non condividerlo con nessuno e non pubblicarlo."
          }
        }
      }
    },
