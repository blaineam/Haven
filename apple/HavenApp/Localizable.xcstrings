            "value": "%1$lld post%2$@ · una copia è sul tuo dispositivo"
          }
        }
      }
    },
    "%lld song%@ in your library aren't on Apple Music, so they can't be shared — your circle wouldn't be able to play them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld song%2$@ in your library aren't on Apple Music, so they can't be shared — your circle wouldn't be able to play them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ内の %1$lld 曲%2$@ は Apple Music にないため、共有できません。サークルのみんなも再生できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Song%2$@ in deiner Mediathek sind nicht bei Apple Music und lassen sich deshalb nicht teilen — dein Kreis könnte sie nicht abspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tema%2$@ de tu biblioteca no están en Apple Music, así que no se pueden compartir — tu círculo no podría reproducirlos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 있는 노래 %1$lld곡%2$@은 Apple Music에 없어서 공유할 수 없습니다 — 서클에 있는 사람들이 재생할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca tem %1$lld música%2$@ fora do Apple Music, então não dá para compartilhar — seu círculo não conseguiria ouvir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld bran%2$@ della tua libreria non sono su Apple Music, quindi non puoi condividerli: la tua cerchia non potrebbe ascoltarli."
          }
        }
      }
    },
