<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- QA stub: App Sandbox ON + distinct bundle id → own container
	     (~/Library/Containers/com.blaineam.kith.qa.stub). Never shares the
	     personal com.blaineam.kith account container. Do not ship/archive. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.get-task-allow</key>
	<true/>
	<!-- The ONE path outside the container the stub may touch: the harness's shared QA directory
	     (qa-cmd/qa-dump/qa-account-hex/peer-bundle staging + the hosted relay store). macOS App Data
	     protection forbids the harness from reading this app's container, so the QA files live here
	     instead (QaFiles.swift, compiled only with -D HAVEN_QA_STUB). Relative to the real home.
	     Stub-only: never in Haven.macOS*.entitlements. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/HavenQA/</string>
	</array>
	<!-- Stub-only keychain groups — not personal kith / kith.shared -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.blaineam.kith.qa.stub</string>
	</array>
</dict>
</plist>
