    "Scan the transfer code from your other device, or paste it below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Übertragungscode von deinem anderen Gerät oder füge ihn unten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código de transferencia desde tu otro dispositivo o pégalo abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code de transfert de votre autre appareil, ou collez-le ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice di trasferimento dall'altro dispositivo, oppure incollalo qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方の端末の転送コードをスキャンするか、下に貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기의 전송 코드를 스캔하거나, 아래에 붙여넣으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código de transferência do seu outro dispositivo ou cole-o abaixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描你另一台设备上的转移码，或在下方粘贴。"
          }
        }
      }
    },
    "Scan their invite QR, or paste the link they sent you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
