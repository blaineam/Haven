    },
    "Hybrid post-quantum encryption. Your keys never leave this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイブリッド耐量子暗号。鍵がこの端末から出ることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybride Post-Quanten-Verschlüsselung. Deine Schlüssel verlassen dieses Gerät nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado híbrido poscuántico. Tus claves nunca salen de este dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하이브리드 양자내성 암호화. 키는 이 기기를 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografia híbrida pós-quântica. Suas chaves nunca saem deste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografia ibrida post-quantistica. Le tue chiavi non lasciano mai questo dispositivo."
          }
        }
      }
    },
