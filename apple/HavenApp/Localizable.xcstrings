    "Where this is stored": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存される場所"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo das gespeichert wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se guarda esto"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되는 위치"
          }
        },
        "pt-BR": {
