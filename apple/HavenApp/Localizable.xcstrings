    "Members can write to the bucket — share only with people you trust, and rotate the key if someone leaves.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーはバケットに書き込めます — 信頼できる人とだけ共有し、誰かが抜けたらキーをローテーションしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitglieder können in den Bucket schreiben — teile ihn nur mit Menschen, denen du vertraust, und wechsle den Schlüssel, wenn jemand geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros pueden escribir en el bucket: compártelo solo con personas de confianza y rota la clave si alguien se va."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성원은 버킷에 쓸 수 있습니다. 신뢰하는 사람과만 공유하고, 누군가 나가면 키를 교체하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os membros podem gravar no bucket — compartilhe apenas com pessoas de confiança e troque a chave se alguém sair."
