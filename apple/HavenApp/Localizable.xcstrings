    "This device is relaying · %@…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末がリレー中 · %@…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät leitet weiter · %@…"
          }
        },
        "es": {
          "stringUnit": {
