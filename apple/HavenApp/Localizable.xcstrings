    "Copy this link, run `haven-relay run --link <link>`, then paste the node id it prints below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクをコピーして `haven-relay run --link <link>` を実行し、表示されたノード ID を下に貼り付けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere diesen Link, führe `haven-relay run --link <link>` aus und füge dann die unten ausgegebene Node-ID hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia este enlace, ejecuta `haven-relay run --link <link>` y luego pega abajo el id de nodo que aparezca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크를 복사한 뒤 `haven-relay run --link <link>`를 실행하고, 출력된 노드 ID를 아래에 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie este link, execute `haven-relay run --link <link>` e cole abaixo o id do nó que aparecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia questo link, esegui `haven-relay run --link <link>`, poi incolla qui sotto l'id del nodo che stampa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez ce lien, exécutez `haven-relay run --link <link>`, puis collez ci-dessous l'identifiant de nœud affiché."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制此链接，运行 `haven-relay run --link <link>`，然后把它输出的节点 ID 粘贴到下方。"
