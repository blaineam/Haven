<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:wemiller.com</string>
	</array>
	<!-- Carrier satellite (T-Satellite and the direct-to-cell services behind it). Declares Haven
	     as optimised for a carrier-constrained network and names its category, which is what makes
	     the app eligible for the bearer. iOS/iPadOS 26.0+; process-level, so it covers the core's
	     QUIC/HTTP traffic and not just Network.framework connections — see
	     docs/SATELLITE-DESIGN.md §2.1. Deliberately NOT on the macOS targets: Apple lists this
	     entitlement for iOS and iPadOS only. -->
	<key>com.apple.developer.networking.carrier-constrained.app-optimized</key>
	<true/>
	<key>com.apple.developer.networking.carrier-constrained.appcategory</key>
	<array>
		<string>messaging-8001</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.blaineam.kith</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.blaineam.kith</string>
		<string>$(AppIdentifierPrefix)com.blaineam.kith.shared</string>
	</array>
</dict>
</plist>
