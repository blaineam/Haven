    "Use “Link a device…” above, then “Add this as another of my devices” there — both stay in sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben „Gerät verknüpfen…“ verwenden, dort dann „Als weiteres meiner Geräte hinzufügen“ — beide bleiben synchron."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “Enlazar un dispositivo…” aquí arriba y luego “Añadir este como otro de mis dispositivos” allí — los dos se mantienen sincronizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « Lier un appareil… » ci-dessus, puis « Ajouter ceci comme un autre de mes appareils » sur l'autre appareil — les deux restent synchronisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “Collega un dispositivo…” qui sopra, poi lì “Aggiungi questo come un altro dei miei dispositivi” — entrambi restano sincronizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上の「デバイスをリンク…」から、そちらで「これも自分のデバイスとして追加」を選んでください — どちらも同期されたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 “기기 연결…”을 누른 다음, 거기서 “내 다른 기기로 추가”를 선택하세요 — 두 기기는 계속 동기화돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use “Vincular um dispositivo…” acima e, lá, “Adicionar este como mais um dos meus dispositivos” — os dois ficam sincronizados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用上面的“连接设备…”，然后在那里选择“把这台设备加为我的另一台设备”——两边会保持同步。"
          }
        }
      }
    },
