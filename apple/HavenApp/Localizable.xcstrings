    "Tunnel is up, but this network's DNS can't resolve it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルは稼働していますが、このネットワークのDNSでは名前解決できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tunnel läuft, aber das DNS in diesem Netzwerk kann ihn nicht auflösen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel está activo, pero el DNS de esta red no puede resolverlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터널은 연결됐지만 이 네트워크의 DNS가 주소를 확인하지 못합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O túnel está ativo, mas o DNS desta rede não consegue resolvê-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tunnel è attivo, ma il DNS di questa rete non riesce a risolverlo."
          }
        }
      }
    },
    "Turn on iCloud backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudバックアップをオンにする"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Backup aktivieren"
          }
        },
        "es": {
