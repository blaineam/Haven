    "It may have been unsent, or it isn't shared with you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信が取り消されたか、あなたには共有されていないようです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht wurde es zurückgezogen, oder es ist nicht für dich freigegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya eliminado o que no lo hayan compartido contigo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 취소되었거나, 나에게 공유되지 않은 항목입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio pode ter sido desfeito, ou não está compartilhado com você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere stato ritirato, oppure non è condiviso con te."
          }
        }
      }
    },
    "It will be removed from your story and for everyone you shared it with.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストーリーからも、共有した全員のところからも削除されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird aus deiner Story entfernt und für alle, mit denen du es geteilt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de tu historia y para todas las personas con quienes lo compartiste."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 스토리에서, 그리고 공유한 모든 사람에게서 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será removido do seu story e para todos com quem você compartilhou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimosso dalla tua storia e per tutti quelli con cui l'hai condiviso."
          }
        }
      }
    },
    "It'll appear here once it syncs from your circle. Nothing is lost.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルから同期されると、ここに表示されます。データが失われることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es erscheint hier, sobald es aus deinem Kreis synchronisiert wird. Nichts geht verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerá aquí en cuanto se sincronice desde tu círculo. No se ha perdido nada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서클에서 동기화되면 여기에 표시됩니다. 사라진 것은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai aparecer aqui assim que sincronizar do seu círculo. Nada foi perdido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparirà qui appena si sincronizza dalla tua cerchia. Non si perde nulla."
          }
        }
      }
    },
