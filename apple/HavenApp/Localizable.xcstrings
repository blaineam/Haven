          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce cercle est verrouillé. Déverrouillez-le avec Face ID pour le consulter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cerchia è bloccata. Sbloccala con Face ID per visualizzarla."
          }
        },
        "ja" : {
          "stringUnit" : {
