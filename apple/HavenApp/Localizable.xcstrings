        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay が見つかりません — 添付ファイルはこのデバイスのみ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Relay bekannt — Anhang nur auf diesem Gerät"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se conoce ningún relay: el adjunto solo está en este dispositivo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려진 Relay 없음 — 첨부 파일이 이 기기에만 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum relay conhecido — anexo só neste dispositivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun relay noto — allegato solo su questo dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun Relay connu — pièce jointe uniquement sur cet appareil"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已知的 Relay — 附件仅保存在本设备"
          }
        }
      }
    },
    "No relay known — story only on this device": {
      "localizations": {
