    "Move an identity to a new device by scanning a QR code, or add/restore one from a transfer code.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR コードをスキャンして ID を新しいデバイスに移すか、転送コードから ID を追加・復元できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe eine Identität auf ein neues Gerät, indem du einen QR-Code scannst, oder füge eine per Transfercode hinzu bzw. stelle sie wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve una identidad a un dispositivo nuevo escaneando un código QR, o añade o restaura una desde un código de transferencia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드를 스캔해 신원을 새 기기로 옮기거나, 전송 코드로 신원을 추가·복구할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova uma identidade para um novo dispositivo escaneando um código QR, ou adicione/restaure uma a partir de um código de transferência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta un'identità su un nuovo dispositivo scansionando un codice QR, oppure aggiungine o ripristinane una da un codice di trasferimento."
          }
        }
      }
    },
