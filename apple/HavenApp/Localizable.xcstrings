    "Works with AWS S3, R2, B2, and more. Keys never leave this device's Keychain.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AWS S3、R2、B2 などに対応。キーがこのデバイスのキーチェーンから出ることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit AWS S3, R2, B2 und mehr. Schlüssel verlassen nie den Schlüsselbund dieses Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con AWS S3, R2, B2 y más. Las claves nunca salen del Llavero de este dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AWS S3, R2, B2 등과 함께 쓸 수 있어요. 키는 이 기기의 키체인을 벗어나지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com AWS S3, R2, B2 e outros. As chaves nunca saem do Keychain deste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona con AWS S3, R2, B2 e altri. Le chiavi non escono mai dal Portachiavi di questo dispositivo."
          }
        }
      }
    },
    "You": {
