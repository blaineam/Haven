      }
    },
    "Every identity you've used on this device — tap one to switch.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで使ったすべてのアイデンティティです。タップすると切り替えられます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Identitäten, die du auf diesem Gerät verwendet hast — tippe auf eine, um zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las identidades que has usado en este dispositivo — toca una para cambiar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 사용한 모든 아이덴티티 — 탭하면 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as identidades que você já usou neste dispositivo — toque em uma para trocar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le identità che hai usato su questo dispositivo — toccane una per cambiare."
          }
        }
      }
    },
    "Everyone you know is already here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知り合いはもう全員ここにいます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die du kennst, sind schon hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus conocidos ya están aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 사람들이 이미 모두 여기 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mundo que você conhece já está aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti quelli che conosci sono già qui."
          }
        }
      }
    },
    "Everyone you know is already on the call.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知り合いはもう全員通話に参加しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die du kennst, sind schon im Anruf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus conocidos ya están en la llamada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 사람들이 이미 모두 통화 중이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mundo que você conhece já está na chamada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti quelli che conosci sono già in chiamata."
          }
        }
      }
    },
    "Everything you share is locked so only your people can see it. No ads, no tracking — ever.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有したものはすべてロックされ、あなたの大切な人だけが見られます。広告も追跡も、一切ありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du teilst, ist verschlüsselt — nur deine Leute können es sehen. Keine Werbung, kein Tracking — niemals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que compartes se cifra para que solo los tuyos puedan verlo. Sin anuncios ni rastreo — nunca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하는 모든 것은 잠겨 있어 내 사람들만 볼 수 있어요. 광고도, 추적도 없습니다 — 영원히."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você compartilha fica protegido para que só as suas pessoas vejam. Sem anúncios, sem rastreamento — nunca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che condividi è protetto: solo le tue persone possono vederlo. Niente pubblicità, niente tracciamento — mai."
          }
        }
      }
    },
    "Everything you share lives here — and a copy stays on your device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有したものはすべてここに集まります。コピーはあなたのデバイスにも残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du teilst, liegt hier — und eine Kopie bleibt auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que compartes vive aquí — y una copia se queda en tu dispositivo."
          }
        },
        "ko": {
