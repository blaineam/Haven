/*
  Haven Web Push registration — who can get a browser's push endpoint filed under an account.
  Symbolic model (Tamarin).

  A phone that holds the account seed registers for push by signing with the account key. A
  browser linked to an account holds NO account key, so it cannot. It registers instead by
  presenting the credential its account signed for it — which names the account, the device's
  key, and the device's class — and signing the endpoint with that device key. The worker checks
  the account's signature on the credential, that the class is 'web', that the credential names
  the key that signed, and files the endpoint under the account. This model checks what that
  rule gives, and puts its stated limit on record.

  Code: push/worker.js (registerWeb, webDeviceOf), core/haven-ffi/src/multidevice.rs
  (web_push_registration), core/haven-p2p/src/device.rs (DeviceCredential::ed25519_proof),
  core/haven-client/src/engine.rs (web_push_register). Spec: docs/WEB-PARITY.md, push/README.md.

  Run:  tamarin-prover --prove docs/formal/haven_web_push.spthy
        tamarin-prover --prove -DNO_CREDENTIAL docs/formal/haven_web_push.spthy

  What is modelled
   - An ACCOUNT has a signing key the worker knows (the account's node id IS its public key).
     A DEVICE has a signing key. The account ENROLS a device with a class, 'app' or 'web', and
     signs a credential naming the account, the device's key and the class.
   - A device ASKS for an endpoint: it sends the credential and its signature over the endpoint.
   - The WORKER files an endpoint under an account when the checks above pass.
   - -DNO_CREDENTIAL models the looser rule deliberately NOT built: the worker takes any device
     key's word for which account it belongs to. R1 is falsified there — anyone files their own
     endpoint under any account and is rung whenever that account is.
   - The account may REVOKE a device. The worker holds no device list, so it learns of a
     revocation only when a device holding the account key tells it (a signed notice); from then
     on it files nothing for that device's key.
   - The adversary controls the network, may take any device's key (a browser whose page was
     replaced) or an account's key, and has devices of its own.

  What is NOT modelled: the endpoint allow-list, freshness of the registration (the 5-minute
  window), expiry after thirty days — all covered by push/worker.test.mjs — and what a push
  carries, which is nothing (an empty body), so there is no confidentiality claim to make.
*/

theory HavenWebPush
begin

builtins: signing

restriction Eq:   "All x y #i. Eq(x, y)@i ==> x = y"
restriction Once: "All t #i #j. Once(t)@i & Once(t)@j ==> #i = #j"
/* The worker refuses to file for a key it has been told is revoked. */
restriction Barred: "All A dk e #b #f. Barred(A, dk)@b & Filed(A, dk, e)@f ==> #f < #b"

/* ---- Keys ---------------------------------------------------------------------------------- */

rule Account:
  [ Fr(~ask) ]
  --[ Once(<'acct', $A>) ]->
  [ !Acct($A, ~ask), !Pin($A, pk(~ask)), Out(pk(~ask)) ]

rule RevealAccount:
  [ !Acct(A, ask) ] --[ RevealAccount(A) ]-> [ Out(ask) ]

rule Device:
  [ Fr(~dsk) ]
  --[ Once(<'dev', $D>), DevKey($D, pk(~dsk)) ]->
  [ !Dev($D, ~dsk), Out(pk(~dsk)) ]

rule RevealDevice:       /* the adversary's own devices, and any device it takes over */
  [ !Dev(D, dsk) ] --[ RevealDevice(D) ]-> [ Out(dsk) ]

/* ---- Enrollment and revocation ------------------------------------------------------------- */

rule EnrolApp:
  let cred = <'cred', $A, pk(dsk), 'app'> in
  [ !Acct($A, ask), !Dev($D, dsk) ]
  --[ Enrolled($A, $D, 'app'), Once(<'enrol', $D>) ]->
  [ !Cred($D, cred, sign(cred, ask)), Out(<cred, sign(cred, ask)>) ]

rule EnrolWeb:
  let cred = <'cred', $A, pk(dsk), 'web'> in
  [ !Acct($A, ask), !Dev($D, dsk) ]
  --[ Enrolled($A, $D, 'web'), Once(<'enrol', $D>) ]->
  [ !Cred($D, cred, sign(cred, ask)), Out(<cred, sign(cred, ask)>) ]

rule Revoke:             /* the account drops the device and signs a notice for the worker */
  [ !Acct($A, ask), !Dev($D, dsk) ]
  --[ Revoked($A, $D) ]->
  [ Out(sign(<'webpush-revoke', $A, pk(dsk)>, ask)) ]

rule WorkerHears:        /* the notice reaches the worker (the network may delay or drop it) */
  [ In(n), !Pin(A, pka) ]
  --[ Eq(verify(n, <'webpush-revoke', A, dk>, pka), true), Barred(A, dk) ]->
  [ ]

/* ---- A device asks, the worker files ------------------------------------------------------- */

rule Ask:                /* an enrolled device asks for its own endpoint */
  [ !Dev($D, dsk), !Cred($D, cred, csig), Fr(~e) ]
  --[ Asked($D, ~e) ]->
  [ Out(<'reg', cred, csig, ~e, sign(<'webpush', ~e>, dsk)>) ]

#ifdef NO_CREDENTIAL
/* NOT BUILT: the worker believes whatever account the request names. */
rule File:
  [ In(<'reg', A, dk, e, rsig>) ]
  --[ Eq(verify(rsig, <'webpush', e>, dk), true), Filed(A, dk, e) ]->
  [ ]
#else
/* AS BUILT: the account signed a credential naming this key as a web device. */
rule File:
  let cred = <'cred', A, dk, 'web'> in
  [ In(<'reg', cred, csig, e, rsig>), !Pin(A, pka) ]
  --[ Eq(verify(csig, cred, pka), true), Eq(verify(rsig, <'webpush', e>, dk), true), Filed(A, dk, e) ]->
  [ ]
#endif

/* ---- Sanity -------------------------------------------------------------------------------- */

lemma executable_a_linked_browser_registers:
  exists-trace
  "Ex A dk e #i. Filed(A, dk, e)@i
     & not (Ex B #r. RevealAccount(B)@r) & not (Ex E #r. RevealDevice(E)@r)"

/* ---- Properties ---------------------------------------------------------------------------- */

/* R1 — only a browser the account linked. An endpoint is filed under an account only for a key
   the account enrolled as a WEB device — unless the account's key leaked. Nobody files their own
   endpoint under someone else's account, whatever they hold of the network.
   Under -DNO_CREDENTIAL this is FALSIFIED. */
lemma R1_an_endpoint_is_filed_only_for_a_browser_the_account_linked:
  "All A dk e #i. Filed(A, dk, e)@i ==>
      (Ex D #k #n. DevKey(D, dk)@k & Enrolled(A, D, 'web')@n)
    | (Ex #r. RevealAccount(A)@r)"

/* R2 — and only the endpoint that browser asked for. The endpoint filed for a linked browser is
   one that device itself asked for — unless the device's key was taken (a browser whose page was
   replaced can be made to ask for anything; that is the stated limit of a web session), or the
   account's key leaked. A relay or a watcher of the network cannot swap in an endpoint of its own. */
lemma R2_the_endpoint_is_the_one_the_browser_asked_for:
  "All A dk e #i. Filed(A, dk, e)@i ==>
      (Ex D #k #a. DevKey(D, dk)@k & Asked(D, e)@a)
    | (Ex D #k #r. DevKey(D, dk)@k & RevealDevice(D)@r)
    | (Ex #r. RevealAccount(A)@r)"

/* R3 — a phone's credential is not a browser's. A device the account enrolled as an app is never
   filed (apps that hold the seed register with the account key; this rule is for browsers only). */
lemma R3_an_app_credential_files_nothing:
  "All A D dk e #n #k #i. Enrolled(A, D, 'app')@n & DevKey(D, dk)@k & Filed(A, dk, e)@i ==>
      (Ex #r. RevealAccount(A)@r)"

/* R4 — only the account can bar a browser. The worker bars a device's key only when that
   account really revoked that device — unless the account's key leaked. A browser cannot bar
   another browser, and nobody can bar the devices of an account that is not theirs. */
lemma R4_only_the_account_bars_a_browser:
  "All A dk #b. Barred(A, dk)@b ==>
      (Ex D #k #v. DevKey(D, dk)@k & Revoked(A, D)@v)
    | (Ex #r. RevealAccount(A)@r)"

/* The stated LIMIT, on record as a reachable trace rather than left unsaid: the worker holds no
   device list, so between the account revoking a browser and the worker hearing of it — the
   notice needs a device with the account key to be online once — the browser can still be filed
   (and so rung) with the credential it kept. What it gets is a doorbell with no content. After the
   worker has heard, it cannot (the Barred restriction is the worker's rule; push/worker.test.mjs
   holds the worker to it). */
lemma limit_a_revoked_browser_can_be_filed_until_the_worker_hears:
  exists-trace
  "Ex A D dk e #v #k #i. Revoked(A, D)@v & DevKey(D, dk)@k & Filed(A, dk, e)@i & #v < #i
     & not (Ex B #r. RevealAccount(B)@r) & not (Ex E #r. RevealDevice(E)@r)"

/* …and the notice works: the worker can come to bar a revoked browser, with nobody's key leaked. */
lemma executable_the_worker_hears_of_a_revocation:
  exists-trace
  "Ex A D dk #v #k #b. Revoked(A, D)@v & DevKey(D, dk)@k & Barred(A, dk)@b
     & not (Ex B #r. RevealAccount(B)@r) & not (Ex E #r. RevealDevice(E)@r)"

end
