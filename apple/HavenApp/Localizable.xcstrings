        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 되었을 때 Haven이 켜져 있으면 전송됩니다 — 서버는 거치지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia na hora certa se o Haven estiver ativo — sem nenhum servidor envolvido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte al momento giusto se Haven è attivo — nessun server coinvolto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi se fait le moment venu si Haven est actif — sans passer par un serveur."
