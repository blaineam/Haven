        }
      }
    },
    "They're in %@, in date order." : {
      "comment" : "A description of the Instagram photos that were imported. The argument is the name of the user's Instagram circle.",
      "isCommentAutoGenerated" : true
    },
    "This circle is locked. Unlock with Face ID to view it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kreis ist gesperrt. Mit Face ID entsperren, um ihn anzusehen."
