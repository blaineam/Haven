    "Sends when the time comes if Haven is awake — no server involved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間になったとき、Havenが起動していれば送信されます — サーバーは使いません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zur gewählten Zeit gesendet, wenn Haven aktiv ist — ganz ohne Server."
