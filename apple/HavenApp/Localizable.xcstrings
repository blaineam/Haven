    "★ covers circles without their own pick. Removing only deactivates.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "★ は独自の選択がないサークルに適用されます。削除しても無効になるだけです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "★ gilt für Kreise ohne eigene Auswahl. Entfernen deaktiviert nur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "★ se aplica a los círculos que no tienen su propia selección. Quitarlo solo lo desactiva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "★는 따로 선택하지 않은 서클에 적용됩니다. 제거해도 비활성화만 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "★ vale para os círculos sem escolha própria. Remover apenas desativa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "★ copre le cerchie senza una scelta propria. La rimozione disattiva soltanto."
          }
        }
      }
    },
