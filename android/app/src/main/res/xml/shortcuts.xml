<?xml version="1.0" encoding="utf-8"?>
<!--
  Share targets for Haven's conversations.

  ShareShortcuts.kt pushes one long-lived dynamic shortcut per recent DM thread, each tagged with
  the category below. This file is what tells the system those shortcuts can RECEIVE a share, which
  is what puts them in the Direct Share row at the top of every app's share sheet. Without it the
  shortcuts still exist (launcher long-press) but never appear when sharing.

  The mime types mirror MainActivity's SEND filters: text and links, photos and videos, and files.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.blaineam.haven.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="application/*" />
        <data android:mimeType="audio/*" />
        <category android:name="com.blaineam.haven.category.SHARE_TARGET" />
    </share-target>

    <!--
      Google Assistant App Action: "Hey Google, send a message to Blaine on Haven".

      Assistant launches MainActivity with this explicit intent; AssistantRoute resolves the recipient
      against the user's contacts and STAGES the text in that conversation's composer. It never sends
      from the intent — any app can fire an explicit intent at an exported activity, so voice sending
      stays on the notification REPLY path (CarMessaging). `name` is the spoken recipient, or the
      matched dynamic shortcut's id (ShareShortcuts binds contact names to this capability).
      Both parameters are optional, so this single intent is also the no-parameters fallback.
      The action and keys must match AssistantRoute (a unit test enforces it).
    -->
    <capability android:name="actions.intent.CREATE_MESSAGE">
        <intent
            android:action="com.blaineam.haven.action.ASSISTANT_MESSAGE"
            android:targetPackage="com.blaineam.haven"
            android:targetClass="com.blaineam.haven.MainActivity">
            <parameter
                android:name="message.text"
                android:key="text" />
            <parameter
                android:name="message.recipient.name"
                android:key="name" />
        </intent>
    </capability>
</shortcuts>
