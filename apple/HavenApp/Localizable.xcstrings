    "What should your\npeople call you?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんなには\n何と呼んでほしい？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sollen dich\ndeine Leute nennen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo quieres que\nte llame tu gente?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 당신을\n뭐라고 부르면 좋을까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você quer que\nas pessoas te chamem?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vuoi che ti\nchiamino i tuoi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment vos proches\ndoivent-ils vous appeler ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望大家\n怎么称呼你？"
          }
        }
      }
    },
    "What this circle is called for you and everyone in it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたとサークルのみんなに表示される、このサークルの名前です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So heißt dieser Kreis für dich und alle darin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de este círculo para ti y para todas las personas que están en él."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나와 서클의 모든 사람에게 보이는 이 서클의 이름이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome deste círculo para você e para todo mundo nele."
          }
