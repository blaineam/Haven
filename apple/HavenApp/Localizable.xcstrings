        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricominciare con un'identità del tutto nuova?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout recommencer avec une identité toute neuve ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用全新的身份重新开始？"
          }
        }
      }
    },
    "Start your relay with `haven-relay run --link <link>`, then paste the JSON (or node id) it prints. No cloud, no credentials.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`haven-relay run --link <link>` で relay を起動し、表示された JSON（またはノード ID）を貼り付けてください。クラウドも認証情報も不要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte dein Relay mit `haven-relay run --link <link>` und füge dann das ausgegebene JSON (oder die Node-ID) hier ein. Keine Cloud, keine Zugangsdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia tu relay con `haven-relay run --link <link>` y luego pega el JSON (o el id de nodo) que muestre. Sin nube, sin credenciales."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`haven-relay run --link <link>`으로 Relay를 시작한 다음, 출력된 JSON(또는 노드 ID)을 붙여넣으세요. 클라우드도, 자격 증명도 필요 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie seu relay com `haven-relay run --link <link>` e cole o JSON (ou o id do node) que ele exibir. Sem nuvem, sem credenciais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il tuo relay con `haven-relay run --link <link>`, poi incolla il JSON (o l'id del nodo) che stampa. Nessun cloud, nessuna credenziale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez votre relay avec `haven-relay run --link <link>`, puis collez le JSON (ou l'identifiant de nœud) qu'il affiche. Pas de cloud, pas d'identifiants."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 `haven-relay run --link <link>` 启动你的 Relay，然后粘贴它输出的 JSON（或节点 ID）。无需云端，无需凭证。"
          }
        }
      }
    },
