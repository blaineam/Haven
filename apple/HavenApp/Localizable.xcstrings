    "Where your circles' sealed posts & media wait for people who were offline.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインだった人のために、サークルの封をされた投稿やメディアが待機する場所です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier warten die versiegelten Beiträge & Medien deiner Kreise auf alle, die offline waren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde las publicaciones y los archivos sellados de tus círculos esperan a quienes estaban sin conexión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이었던 사람들을 위해 서클의 봉인된 게시물과 미디어가 기다리는 곳이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde as publicações e mídias seladas dos seus círculos esperam por quem estava offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove i post e i media sigillati delle tue cerchie aspettano chi era offline."
          }
        }
      }
    },
    "Whichever limit hits first wins. Undelivered messages are never swept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に達した方の上限が適用されます。未配信のメッセージが消されることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gilt, welches Limit zuerst erreicht wird. Nicht zugestellte Nachrichten werden nie gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica el límite que se alcance primero. Los mensajes sin entregar nunca se borran."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 도달하는 제한이 적용돼요. 아직 전달되지 않은 메시지는 삭제되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale o limite que for atingido primeiro. Mensagens não entregues nunca são apagadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale il limite che scatta per primo. I messaggi non consegnati non vengono mai eliminati."
          }
        }
      }
    },
