    },
    "Posts mirror to every relay — any reachable one keeps the circle syncing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge werden auf jedes Relay gespiegelt — schon ein erreichbares hält den Kreis synchron."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las publicaciones se replican en todos los relays: basta con que uno esté accesible para que el círculo siga sincronizándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publications sont répliquées sur tous les relays — il suffit que l'un d'eux soit joignable pour que le cercle reste synchronisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I post vengono replicati su tutti i relay: basta che uno sia raggiungibile per mantenere sincronizzata la cerchia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿はすべての Relay にミラーされます — どれか 1 つにつながっていれば、サークルの同期は続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시물은 모든 Relay에 복제돼요 — 연결 가능한 Relay가 하나만 있어도 서클은 계속 동기화돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
