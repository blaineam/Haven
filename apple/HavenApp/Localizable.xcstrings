    "That code isn't valid. Check you copied the whole thing.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコードは正しくありません。全体をコピーできているか確認してください。"
          }
        },
        "de": {
          "stringUnit": {
