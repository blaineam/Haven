<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A bare Material3 base theme. The real visual language lives in Compose (HavenTheme).
         We disable the action bar since the whole UI is Compose. -->
    <style name="Theme.Haven" parent="android:Theme.Material.NoActionBar">
        <!-- Both of these resolve per-mode out of values/ vs values-night/. ONE style definition so a
             future item can't silently drift between the two modes. -->
        <item name="android:windowBackground">@color/haven_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/haven_light_status_bar</item>
    </style>

    <!-- Invisible host for the system screen-share consent (ScreenShareConsentActivity): the call
         stays visible behind the system dialog. -->
    <style name="Theme.Haven.Consent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
