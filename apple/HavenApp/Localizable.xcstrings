          }
        }
      }
    },
    "Your media saves to **Haven ▸ Shared**; media sent to you saves to **Haven ▸ Received**.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのメディアは **Haven ▸ Shared** に、あなた宛てに送られたメディアは **Haven ▸ Received** に保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Medien werden in **Haven ▸ Geteilt** gespeichert; an dich gesendete Medien in **Haven ▸ Empfangen**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos se guardan en **Haven ▸ Compartidos**; los que te envían se guardan en **Haven ▸ Recibidos**."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 보낸 미디어는 **Haven ▸ Shared**에, 나에게 온 미디어는 **Haven ▸ Received**에 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas mídias são salvas em **Haven ▸ Compartilhadas**; as mídias enviadas para você são salvas em **Haven ▸ Recebidas**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi media vengono salvati in **Haven ▸ Condivisi**; i media che ricevi vengono salvati in **Haven ▸ Ricevuti**."
          }
        }
      }
    },
    "Your name": {
      "localizations": {
