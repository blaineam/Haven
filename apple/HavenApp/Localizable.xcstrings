      }
    },
    "How this person shows up for you — long-press anyone in your circle to set it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その人があなたの中でどんな存在か — サークルの相手を長押しして設定できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie diese Person bei dir erscheint — halte jemanden in deinem Kreis gedrückt, um das festzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo aparece esta persona para ti — mantén pulsado a cualquiera de tu círculo para configurarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람이 나에게 어떻게 표시되는지 — 서클에 있는 사람을 길게 눌러 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como esta pessoa aparece para você — toque e segure qualquer pessoa do seu círculo para definir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come questa persona si presenta a te — tieni premuto su chiunque nella tua cerchia per impostarlo."
          }
        }
      }
    },
    "How to set one up": {
      "localizations": {
