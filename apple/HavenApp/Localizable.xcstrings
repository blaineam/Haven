            "value": "仅对我隐藏"
          }
        }
      }
    },
    "Hide hidden posts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示にした投稿を隠す"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Beiträge verbergen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar las publicaciones ocultas"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 게시물 가리기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar publicações ocultas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi i post nascosti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les publications masquées"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏已隐藏的帖子"
          }
        }
      }
    },
    "Hides old posts from your feed only — never deletes anything for anyone else.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のフィードから古い投稿を隠すだけです。ほかの人から何かが削除されることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet alte Beiträge nur in deinem Feed aus — löscht nie etwas für andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las publicaciones antiguas solo en tu feed — nunca borra nada para los demás."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 피드에서만 오래된 게시물을 숨겨요 — 다른 사람에게서는 아무것도 삭제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta publicações antigas apenas do seu feed — nunca apaga nada para as outras pessoas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde i vecchi post solo dal tuo feed — non elimina mai nulla per gli altri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les anciennes publications de votre fil uniquement — cela ne supprime jamais rien pour les autres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你的动态里隐藏旧帖子，不会为其他任何人删除任何内容。"
          }
        }
      }
    },
    "Hides the post for you now; your circle sees the report. Nothing is ever logged.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ自分の画面から投稿を非表示にします。報告はサークルのみんなに共有されます。ログが残ることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet den Beitrag sofort für dich aus; dein Kreis sieht die Meldung. Es wird nie etwas protokolliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la publicación para ti ahora; tu círculo ve la denuncia. Nunca se registra nada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 게시물이 나에게만 숨겨지고, 서클에는 신고 내용이 전달됩니다. 어떤 기록도 남지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta a publicação para você agora; seu círculo vê a denúncia. Nada é registrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde subito il post per te; la tua cerchia vede la segnalazione. Non viene registrato nulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque la publication pour vous dès maintenant ; votre cercle voit le signalement. Rien n'est jamais enregistré."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条帖子现在只对你隐藏；你的圈子会看到这次举报。我们从不记录任何内容。"
          }
        }
      }
    },
    "Holds sealed posts for offline members while Haven is open. A Mac is best.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Havenを開いている間、オフラインのメンバーのために暗号化された投稿を預かります。Macが最適です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahrt versiegelte Beiträge für gerade offline Mitglieder auf, solange Haven geöffnet ist. Am besten ein Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las publicaciones selladas para los miembros desconectados mientras Haven esté abierto. Un Mac es lo ideal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven이 켜져 있는 동안 오프라인 멤버를 위해 봉인된 게시물을 보관해요. Mac이 가장 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda publicações lacradas para os membros offline enquanto o Haven estiver aberto. Um Mac é o ideal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i post sigillati per i membri offline mentre Haven è aperto. Meglio un Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les publications scellées pour les membres hors ligne tant que Haven est ouvert. Un Mac est idéal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Haven 处于打开状态时，为离线成员保管加密封存的帖子。用 Mac 最合适。"
          }
        }
      }
    },
    "Holds this circle's sealed posts for offline members — it only ever sees ciphertext.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのメンバーのために、このサークルの暗号化された投稿を預かります。見えるのは暗号文だけです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahrt die versiegelten Beiträge dieses Kreises für gerade offline Mitglieder auf — es sieht dabei immer nur verschlüsselte Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las publicaciones selladas de este círculo para los miembros desconectados — solo ve texto cifrado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 멤버를 위해 이 서클의 봉인된 게시물을 보관해요 — 암호문 외에는 아무것도 보지 못합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as publicações lacradas deste círculo para os membros offline — ele só enxerga texto cifrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i post sigillati di questa cerchia per i membri offline — vede sempre e solo testo cifrato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les publications scellées de ce cercle pour les membres hors ligne — il ne voit jamais que du chiffré."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为离线成员保管这个圈子加密封存的帖子——它只能看到密文。"
          }
        }
      }
    },
    "How Haven works": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Havenのしくみ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert Haven"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona Haven"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven 작동 방식"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Haven funciona"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come funziona Haven"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment fonctionne Haven"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Haven 的运作方式"
          }
        }
      }
    },
    "How this person shows up for you — long-press anyone in your circle to set it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その人があなたの中でどんな存在か — サークルの相手を長押しして設定できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie diese Person bei dir erscheint — halte jemanden in deinem Kreis gedrückt, um das festzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo aparece esta persona para ti — mantén pulsado a cualquiera de tu círculo para configurarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람이 나에게 어떻게 표시되는지 — 서클에 있는 사람을 길게 눌러 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como esta pessoa aparece para você — toque e segure qualquer pessoa do seu círculo para definir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come questa persona si presenta a te — tieni premuto su chiunque nella tua cerchia per impostarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La façon dont cette personne apparaît pour vous — appuyez longuement sur n'importe qui de votre cercle pour la définir."
          }
        },
