          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Online"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
