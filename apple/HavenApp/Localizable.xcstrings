        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소개와 링크는 서클에 있는 사람들에게 프로필에서 보여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua bio e seu link aparecem no seu perfil para as pessoas do seu círculo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的简介和链接会显示在你的个人资料上，圈子里的人都能看到。"
          }
        }
      }
    },
    "Your bucket keeps the circle synced; credentials stay on the circle's devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Bucket hält den Kreis synchron; die Zugangsdaten bleiben auf den Geräten des Kreises."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bucket mantiene el círculo sincronizado; las credenciales se quedan en los dispositivos del círculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre bucket garde le cercle synchronisé ; les identifiants restent sur les appareils du cercle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo bucket mantiene la cerchia sincronizzata; le credenziali restano sui dispositivi della cerchia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのバケットがサークルの同期を保ちます。認証情報はサークルのデバイスから出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버킷이 서클을 동기화해 주고, 자격 증명은 서클의 기기에만 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
