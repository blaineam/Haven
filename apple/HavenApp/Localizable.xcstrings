    "Your primary device keeps handling notifications for the new device for now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当面は、新しいデバイスの通知もメインのデバイスが処理します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Hauptgerät übernimmt vorerst weiterhin die Mitteilungen für das neue Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, tu dispositivo principal sigue gestionando las notificaciones del nuevo dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당분간은 기본 기기가 새 기기의 알림도 함께 처리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto, seu dispositivo principal continua cuidando das notificações do novo dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora il tuo dispositivo principale continua a gestire le notifiche per il nuovo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, votre appareil principal continue de gérer les notifications du nouvel appareil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时仍由你的主设备为新设备处理通知。"
          }
        }
      }
    },
