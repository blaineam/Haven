    "Say “Hey Siri, send a message with Haven” once you have someone to talk to." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „Hey Siri, sende eine Nachricht mit Haven“, sobald du jemanden zum Schreiben hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di «Oye Siri, envía un mensaje con Haven» cuando tengas con quién hablar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di’ «Ehi Siri, invia un messaggio con Haven» quando avrai qualcuno con cui parlare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話し相手ができたら「Hey Siri、Havenでメッセージを送信」と言ってみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 상대가 생기면 “시리야, Haven으로 메시지 보내줘”라고 말해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “E aí Siri, envie uma mensagem com o Haven” quando tiver com quem conversar."
          }
        }
      }
    },
