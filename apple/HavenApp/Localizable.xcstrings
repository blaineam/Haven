            "value": "Vuoi conservare anche questo dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gardez aussi cet appareil ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备也要保留吗？"
          }
        }
      }
    },
    "Keeps relaying with no window after you close it — launch Haven again to reopen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じてもウインドウなしで中継を続けます — もう一度開くには Haven を起動してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet auch ohne Fenster weiter, nachdem du es geschlossen hast — starte Haven erneut, um es wieder zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue retransmitiendo sin ventana después de cerrarla — vuelve a abrir Haven para mostrarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창을 닫아도 창 없이 계속 중계합니다 — 다시 열려면 Haven을 실행하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua retransmitindo sem janela depois que você fechar — abra o Haven de novo para reabrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a fare da relay senza finestra dopo la chiusura — riapri Haven per mostrarla di nuovo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de relayer sans fenêtre après la fermeture — relancez Haven pour la rouvrir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后仍会继续中继 —— 再次启动 Haven 即可重新打开窗口。"
          }
        }
      }
    },
