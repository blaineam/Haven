    },
    "The ground rules": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本ルール"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grundregeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las normas básicas"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 규칙"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras básicas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole di base"
          }
        }
      }
    },
    "The primary holds your master key and authorizes your other devices — pick ONE (e.g. your iPhone).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライマリ端末はマスターキーを保管し、ほかの端末を承認します — 1台だけ選んでください（例：iPhone）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das primäre Gerät enthält deinen Hauptschlüssel und autorisiert deine anderen Geräte — wähle EINS (z. B. dein iPhone)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo principal guarda tu clave maestra y autoriza tus demás dispositivos — elige UNO (por ejemplo, tu iPhone)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 기기는 마스터 키를 보관하고 다른 기기를 승인합니다 — 하나만 선택하세요(예: iPhone)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo principal guarda sua chave mestra e autoriza os outros — escolha APENAS UM (por exemplo, seu iPhone)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo principale custodisce la tua chiave madre e autorizza gli altri dispositivi — scegline UNO (ad es. il tuo iPhone)."
          }
        }
      }
    },
    "Their own name will appear once you connect — they choose it, signed with their key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の名前は接続すると表示されます — 名前は相手が決め、相手の鍵で署名されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr eigener Name erscheint, sobald ihr verbunden seid — sie wählen ihn selbst, signiert mit ihrem Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nombre aparecerá en cuanto se conecten — lo elige esa persona y va firmado con su clave."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되면 상대방이 직접 정한 이름이 표시됩니다 — 그 이름은 상대방의 키로 서명됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome que essa pessoa usa aparece assim que vocês se conectarem — ela mesma escolhe, assinado com a chave dela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il loro nome comparirà quando vi collegherete — lo scelgono loro, firmato con la loro chiave."
          }
        }
      }
    },
    "Their posts leave your view of the circle and they can't rejoin through you. Your own devices stay in sync.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の投稿はあなたのサークル表示から消え、あなた経由では再参加できなくなります。あなた自身の端末どうしは同期されたままです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Beiträge verschwinden aus deiner Ansicht des Kreises und sie können über dich nicht wieder beitreten. Deine eigenen Geräte bleiben synchron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus publicaciones desaparecen de tu vista del círculo y no podrá volver a unirse a través de ti. Tus dispositivos se mantienen sincronizados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방의 게시물이 내 서클 화면에서 사라지고, 나를 통해서는 다시 참여할 수 없습니다. 내 기기끼리는 계속 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As publicações dessa pessoa saem da sua visão do círculo e ela não consegue voltar por meio de você. Seus próprios dispositivos continuam sincronizados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro post spariscono dalla tua vista della cerchia e non potranno rientrare tramite te. I tuoi dispositivi restano sincronizzati."
          }
        }
      }
    },
    "There are no messages yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだメッセージはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Nachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay mensajes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 메시지가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há mensagens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora messaggi."
          }
        }
      }
    },
    "There's no post to reply to yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信できる投稿はまだありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keinen Beitrag, auf den du antworten kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ninguna publicación a la que responder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 답글을 달 게시물이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há publicação para responder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora nessun post a cui rispondere."
          }
        }
      }
    },
    "They say they made this circle. We can't check that, so only follow if that's right — whoever you follow will be able to remove people.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人はこのサークルを作ったと言っています。こちらでは確認できないので、間違いない場合だけフォローしてください — フォローした相手はメンバーを削除できるようになります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sagen, sie hätten diesen Kreis erstellt. Wir können das nicht überprüfen — folge nur, wenn das stimmt: Wem du folgst, der kann Personen entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice que creó este círculo. No podemos comprobarlo, así que sigue a esa persona solo si es cierto — quien sigas podrá expulsar a otras personas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서클을 만들었다고 하지만 저희가 확인할 수는 없습니다. 사실일 때만 팔로우하세요 — 팔로우한 사람은 다른 사람을 내보낼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pessoa diz que criou este círculo. Não temos como verificar, então só siga se isso estiver certo — quem você seguir vai poder remover pessoas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicono di aver creato questa cerchia. Non possiamo verificarlo, quindi segui solo se è davvero così — chi segui potrà rimuovere persone."
          }
        }
      }
    },
    "They'll be able to see what you've shared with this circle, including past posts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがこのサークルで共有したものを、過去の投稿も含めて相手が見られるようになります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können sehen, was du mit diesem Kreis geteilt hast, auch frühere Beiträge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrá ver lo que has compartido con este círculo, incluidas las publicaciones anteriores."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서클에 공유한 내용을 지난 게시물까지 모두 볼 수 있게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pessoa vai poder ver o que você compartilhou com este círculo, inclusive publicações antigas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potranno vedere ciò che hai condiviso con questa cerchia, compresi i post passati."
          }
        }
      }
    },
    "They'll show up once you're both online.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お互いがオンラインになると表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erscheinen, sobald ihr beide online seid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerán cuando los dos estén en línea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 온라인이 되면 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vão aparecer assim que vocês dois estiverem online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compariranno quando sarete entrambi online."
          }
        }
      }
    },
    "This circle is locked. Unlock with Face ID to view it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサークルはロックされています。Face IDでロックを解除すると表示できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kreis ist gesperrt. Mit Face ID entsperren, um ihn anzusehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este círculo está bloqueado. Desbloquéalo con Face ID para verlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠긴 서클입니다. Face ID로 잠금을 해제하면 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este círculo está bloqueado. Desbloqueie com o Face ID para vê-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cerchia è bloccata. Sbloccala con Face ID per visualizzarla."
          }
        }
      }
    },
    "This code grants your identity. Only scan it onto a device you own — never share or post it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードはあなたのアイデンティティを引き渡します。自分の端末でのみスキャンしてください — 共有や投稿は絶対にしないでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code überträgt deine Identität. Scanne ihn nur auf ein Gerät, das dir gehört — teile oder veröffentliche ihn niemals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código otorga tu identidad. Escanéalo solo en un dispositivo tuyo — nunca lo compartas ni lo publiques."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 내 신원을 그대로 넘겨줍니다. 본인 소유 기기에서만 스캔하고, 절대 공유하거나 게시하지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código concede sua identidade. Escaneie apenas em um dispositivo seu — nunca compartilhe nem publique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice concede la tua identità. Scansionalo solo su un dispositivo tuo — non condividerlo e non pubblicarlo mai."
          }
        }
      }
    },
    "This code links one device, once, and expires after a few minutes. Only scan it onto a device you own.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは1台の端末を1回だけ連携でき、数分で期限切れになります。自分の端末でのみスキャンしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code verbindet ein Gerät, einmalig, und läuft nach wenigen Minuten ab. Scanne ihn nur auf ein Gerät, das dir gehört."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código vincula un dispositivo, una sola vez, y caduca en unos minutos. Escanéalo solo en un dispositivo tuyo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 기기 하나를 한 번만 연결하며 몇 분 뒤 만료됩니다. 본인 소유 기기에서만 스캔하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código vincula um dispositivo, uma única vez, e expira em alguns minutos. Escaneie apenas em um dispositivo seu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice collega un solo dispositivo, una sola volta, e scade dopo pochi minuti. Scansionalo solo su un dispositivo tuo."
          }
        }
      }
    },
    "This conversation isn't on this device yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話はまだこの端末にありません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung ist noch nicht auf diesem Gerät"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación aún no está en este dispositivo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 아직 이 기기에 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa ainda não está neste dispositivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa conversazione non è ancora su questo dispositivo"
          }
        }
      }
    },
    "This device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末"
          }
        },
        "de": {
