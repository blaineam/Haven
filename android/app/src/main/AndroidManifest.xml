<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haven uses NO advertising ID. A transitive Play-services dep pulls AD_ID in at manifest-merge;
         strip it explicitly so the app provably can't read the advertising ID and the Play "advertising
         ID" declaration is a clean "No". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- P2P transport, mailbox, relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: attach your current location to a post (geo: ref, iOS parity). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Wave 3+: camera, mic, media. Declared early so the manifest is stable. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Route call audio to the loudspeaker/earpiece (the in-call speaker toggle). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground "stay connected" service (keeps the iroh node alive for real-time delivery). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Screen sharing in a call (MediaProjection) — Android 14+ requires this FGS type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Nearby Connections (offline mesh). Location is required for BLE scanning on API <= 30. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".HavenApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haven">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Haven">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- haven:// invite + deep links (parity with the iOS URL scheme). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="haven" />
            </intent-filter>
            <!-- The WEB links (https://wemiller.com/apps/haven/open/#…) — invites and post links, so a
                 tapped link lands in the app with no chooser. Verified against
                 web/.well-known/assetlinks.json on the domain. The payload stays in the fragment,
                 which the browser never sends to the host — see docs/LINK-SYSTEM.md.

                 The prefix is `/apps/haven/open`, NOT `/apps/haven`. Android App Links match on
                 scheme/host/path ONLY — a fragment is never visible to the matcher — so the wider
                 prefix claimed the entire website: the marketing home page, /features/, /docs/ and
                 /relay/ all offered to open Haven, on every visit. (iOS could gate on "has a
                 fragment" via the AASA, which is why this diverged; that gate misfired too, on the
                 site's own #anchors.) A dedicated landing path is the only rule both platforms can
                 express. Do NOT widen this back to /apps/haven. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wemiller.com" android:pathPrefix="/apps/haven/open" />
            </intent-filter>
            <!-- Share a YouTube/web link (or any text) from another app into Haven. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share photos/videos from another app (Photos, Gallery, Files) into Haven. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />
    </application>
</manifest>
