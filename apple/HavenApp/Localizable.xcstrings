    "Scan the transfer code from your other device, or paste it below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の端末の転送コードをスキャンするか、下に貼り付けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Übertragungscode von deinem anderen Gerät oder füge ihn unten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código de transferencia desde tu otro dispositivo o pégalo abajo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기의 전송 코드를 스캔하거나, 아래에 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código de transferência do seu outro dispositivo ou cole-o abaixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice di trasferimento dall'altro dispositivo, oppure incollalo qui sotto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code de transfert de votre autre appareil, ou collez-le ci-dessous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描你另一台设备上的转移码，或在下方粘贴。"
          }
        }
      }
    },
    "Scan their invite QR, or paste the link they sent you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の招待QRをスキャンするか、送られてきたリンクを貼り付けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Einladungs-QR-Code oder füge den Link ein, den du bekommen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea su QR de invitación o pega el enlace que te enviaron."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방의 초대 QR을 스캔하거나, 받은 링크를 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o QR do convite ou cole o link que enviaram para você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il QR del loro invito, oppure incolla il link che ti hanno mandato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le QR d'invitation, ou collez le lien qu'on vous a envoyé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描对方的邀请二维码，或粘贴对方发给你的链接。"
          }
        }
      }
    },
