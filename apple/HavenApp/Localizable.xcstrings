    "Turn on iCloud backup to recover an identity from another Apple device — no code needed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudバックアップをオンにすると、ほかのAppleデバイスからアイデンティティを復元できます — コードは不要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere das iCloud-Backup, um eine Identität von einem anderen Apple-Gerät wiederherzustellen — ganz ohne Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la copia de seguridad de iCloud para recuperar una identidad desde otro dispositivo Apple — sin necesidad de código."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Apple 기기에 있는 신원을 코드 없이 복구하려면 iCloud 백업을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o backup do iCloud para recuperar uma identidade a partir de outro dispositivo Apple — sem precisar de código."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il backup iCloud per recuperare un'identità da un altro dispositivo Apple — senza bisogno di codice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la sauvegarde iCloud pour récupérer une identité depuis un autre appareil Apple — aucun code nécessaire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启 iCloud 备份，就能从另一台 Apple 设备恢复身份 — 无需代码。"
          }
        }
      }
    },
