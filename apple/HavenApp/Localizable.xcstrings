    "Address works on your network only — others connect peer-to-peer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse funktioniert nur in deinem Netzwerk — andere verbinden sich per Peer-to-Peer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección solo funciona en tu red — los demás se conectan de igual a igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse ne fonctionne que sur votre réseau — les autres se connectent en pair à pair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indirizzo funziona solo sulla tua rete — gli altri si connettono peer-to-peer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスは同じネットワーク内でのみ使えます — ほかの人はピアツーピアで接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 내 네트워크에서만 작동해요 — 다른 사람은 P2P로 연결됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço funciona apenas na sua rede — as outras pessoas se conectam ponto a ponto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该地址仅在你的网络内有效——其他人通过点对点连接。"
          }
        }
      }
    },
