    "Sealed posts & media live here and re-serve to your circles when someone's been offline.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "封をした投稿とメディアはここに保管され、オフラインだった人がいればサークルへ再配信されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiegelte Beiträge und Medien liegen hier und werden erneut an deine Kreise ausgeliefert, wenn jemand offline war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones y los archivos sellados viven aquí y se reenvían a tus círculos cuando alguien ha estado sin conexión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봉인된 게시물과 미디어가 여기에 보관되고, 오프라인이었던 사람이 돌아오면 서클에 다시 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicações e mídias lacradas ficam aqui e são reenviadas aos seus círculos quando alguém fica um tempo offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Post e contenuti sigillati restano qui e vengono riproposti alle tue cerchie quando qualcuno torna online."
          }
        }
      }
    },
