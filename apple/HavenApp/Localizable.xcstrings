    "You can close Haven too — it picks up where it left off." : {

    },
    "You'll be connected the moment you're both online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr werdet verbunden, sobald ihr beide online seid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conectarán en cuanto ambos estén en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez connectés dès que vous serez tous les deux en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarete connessi non appena sarete entrambi online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二人ともオンラインになった瞬間につながります。"
