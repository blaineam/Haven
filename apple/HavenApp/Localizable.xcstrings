            "value" : "このサークルはロックされています。Face IDでロックを解除すると表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠긴 서클입니다. Face ID로 잠금을 해제하면 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este círculo está bloqueado. Desbloqueie com o Face ID para vê-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
