    "Your circle shares this bucket. Only sealed, unreadable data is stored there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kreis teilt sich diesen Bucket. Dort werden nur versiegelte, unlesbare Daten gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu círculo comparte este bucket. Allí solo se guardan datos sellados e ilegibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre cercle partage ce bucket. Seules des données scellées et illisibles y sont stockées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
