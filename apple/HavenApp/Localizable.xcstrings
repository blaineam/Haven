    "You'll be connected the moment you're both online.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二人ともオンラインになった瞬間につながります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr werdet verbunden, sobald ihr beide online seid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conectarán en cuanto ambos estén en línea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사람 모두 온라인이 되는 순간 연결돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês serão conectados assim que os dois estiverem online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarete connessi non appena sarete entrambi online."
          }
        }
      }
    },
    "Your bio and link show on your profile for the people in your circle.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自己紹介とリンクは、サークルの人たちに見えるプロフィールに表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bio und dein Link erscheinen in deinem Profil für die Leute in deinem Kreis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biografía y tu enlace aparecen en tu perfil para las personas de tu círculo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소개와 링크는 서클에 있는 사람들에게 프로필에서 보여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua bio e seu link aparecem no seu perfil para as pessoas do seu círculo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua bio e il tuo link compaiono sul tuo profilo per le persone della tua cerchia."
          }
        }
      }
    },
    "Your bucket keeps the circle synced; credentials stay on the circle's devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのバケットがサークルの同期を保ちます。認証情報はサークルのデバイスから出ません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bucket hält den Kreis synchron; die Zugangsdaten bleiben auf den Geräten des Kreises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bucket mantiene el círculo sincronizado; las credenciales se quedan en los dispositivos del círculo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버킷이 서클을 동기화해 주고, 자격 증명은 서클의 기기에만 남아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu bucket mantém o círculo sincronizado; as credenciais ficam nos dispositivos do círculo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo bucket mantiene la cerchia sincronizzata; le credenziali restano sui dispositivi della cerchia."
          }
        }
      }
    },
    "Your circle is private": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのサークルはプライベートです"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kreis ist privat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu círculo es privado"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서클은 비공개예요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu círculo é privado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cerchia è privata"
          }
        }
      }
    },
    "Your circle shares this bucket. Only sealed, unreadable data is stored there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルのみんなでこのバケットを共有します。保存されるのは封をされた、読み取れないデータだけです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kreis teilt sich diesen Bucket. Dort werden nur versiegelte, unlesbare Daten gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu círculo comparte este bucket. Allí solo se guardan datos sellados e ilegibles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서클이 이 버킷을 함께 써요. 봉인되어 읽을 수 없는 데이터만 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu círculo compartilha este bucket. Só ficam armazenados lá dados selados e ilegíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cerchia condivide questo bucket. Vi sono archiviati solo dati sigillati e illeggibili."
          }
        }
      }
    },
    "Your current identity stays saved here, so you can switch back anytime.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のアイデンティティはここに保存されたままなので、いつでも戻せます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuelle Identität bleibt hier gespeichert, du kannst also jederzeit zurückwechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identidad actual se queda guardada aquí, así puedes volver a ella cuando quieras."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 신원은 여기에 그대로 저장돼 있어서 언제든 다시 전환할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua identidade atual continua salva aqui, então você pode voltar para ela quando quiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua identità attuale resta salvata qui, così puoi tornarci quando vuoi."
          }
        }
      }
    },
    "Your identities": {
      "localizations": {
        "ja": {
