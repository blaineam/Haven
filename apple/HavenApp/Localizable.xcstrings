          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para ver el detalle de la sincronización en vivo. Amarillo: aún sincronizando. Rojo: solo en este dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 실시간 동기화 상세 정보를 볼 수 있습니다. 노란색: 아직 동기화 중. 빨간색: 이 기기에만 있음."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
