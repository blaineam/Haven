    "Use Advanced ▸ Transfer my identity — your identity moves instead of being copied.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細設定 ▸ アイデンティティを移行 を使ってください — コピーではなく、アイデンティティそのものが移ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitert ▸ Meine Identität übertragen verwenden — deine Identität wird verschoben statt kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Avanzado ▸ Transferir mi identidad — tu identidad se traslada en lugar de copiarse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 ▸ 내 신원 이전을 사용하세요 — 신원이 복사되는 게 아니라 이동해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Avançado ▸ Transferir minha identidade — sua identidade é movida, e não copiada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Avanzate ▸ Trasferisci la mia identità — la tua identità viene spostata invece che copiata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Avancé ▸ Transférer mon identité — votre identité est déplacée au lieu d'être copiée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用“高级 ▸ 转移我的身份”——你的身份会被移过去，而不是复制一份。"
          }
        }
      }
    },
