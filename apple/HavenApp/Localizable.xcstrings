          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a Dominio personalizado o Manual: los nombres de host de túnel gratuitos no se resuelven en esta red."
          }
        },
        "ko": {
          "stringUnit": {
