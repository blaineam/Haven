    "Add a Haven relay by node id, or bring your own S3 bucket as a store-and-forward relay.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノード ID で Haven の Relay を追加するか、自分の S3 バケットをストアアンドフォワード型の Relay として使えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Haven-Relay per Node-ID hinzu oder nutze deinen eigenen S3-Bucket als Store-and-Forward-Relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un Relay de Haven con su ID de nodo, o usa tu propio bucket de S3 como Relay de almacenamiento y reenvío."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 ID로 Haven Relay를 추가하거나, 직접 사용하는 S3 버킷을 저장 후 전달 방식의 Relay로 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um relay do Haven pelo ID do nó ou use seu próprio bucket S3 como relay de armazenamento e encaminhamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un relay Haven tramite l'id del nodo, oppure usa il tuo bucket S3 come relay store-and-forward."
          }
        }
      }
    },
    "Add a label (optional) — e.g. \"My place\"": {
