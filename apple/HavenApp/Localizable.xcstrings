          }
        }
      }
    },
    "No relay known for this circle — media stays on this device only. Open Relays or wait for a member who hosts one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサークルの Relay が見つかりません — メディアはこのデバイスにのみ残ります。Relay を開くか、Relay を提供しているメンバーが現れるまでお待ちください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Kreis ist kein Relay bekannt — Medien bleiben nur auf diesem Gerät. Öffne „Relays“ oder warte auf ein Mitglied, das eines betreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se conoce ningún relay para este círculo: el contenido se queda solo en este dispositivo. Abre Relays o espera a que algún miembro aloje uno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서클에 알려진 Relay가 없습니다 — 미디어는 이 기기에만 남습니다. Relay를 열거나 Relay를 운영하는 멤버를 기다리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum relay conhecido para este círculo — a mídia fica só neste dispositivo. Abra Relays ou espere um integrante que hospede um."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun relay noto per questa cerchia — i contenuti restano solo su questo dispositivo. Apri Relay o aspetta un membro che ne ospiti uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun Relay connu pour ce cercle — les médias restent uniquement sur cet appareil. Ouvrez Relays ou attendez qu'un membre en héberge un."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个圈子还没有已知的 Relay — 媒体只会留在本设备上。打开 Relays,或等待有成员提供一个。"
          }
        }
      }
    },
    "No relays configured yet. Add one below, or flip the toggle above to use this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay はまだ設定されていません。下から追加するか、上のスイッチをオンにしてこのデバイスを使ってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Relays eingerichtet. Füge unten eines hinzu oder aktiviere oben den Schalter, um dieses Gerät zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay relays configurados. Añade uno abajo o activa el interruptor de arriba para usar este dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 설정된 Relay가 없습니다. 아래에서 추가하거나, 위의 스위치를 켜서 이 기기를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum relay configurado ainda. Adicione um abaixo ou ative a opção acima para usar este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun relay configurato. Aggiungine uno qui sotto, oppure attiva l'opzione qui sopra per usare questo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun Relay configuré pour l'instant. Ajoutez-en un ci-dessous, ou activez l'option ci-dessus pour utiliser cet appareil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有配置任何 Relay。在下方添加一个,或打开上方的开关以使用本设备。"
          }
        }
      }
    },
    "No shareable content found. Grant Screen Recording permission in System Settings ▸ Privacy & Security.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できるコンテンツが見つかりません。システム設定 ▸ プライバシーとセキュリティ で画面収録を許可してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine teilbaren Inhalte gefunden. Erteile die Berechtigung „Bildschirmaufnahme“ in den Systemeinstellungen ▸ Datenschutz & Sicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró contenido para compartir. Concede el permiso de Grabación de pantalla en Ajustes del Sistema ▸ Privacidad y seguridad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유할 수 있는 콘텐츠를 찾지 못했습니다. 시스템 설정 ▸ 개인정보 보호 및 보안에서 화면 기록 권한을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum conteúdo compartilhável encontrado. Conceda a permissão de Gravação de Tela em Ajustes do Sistema ▸ Privacidade e Segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun contenuto condivisibile trovato. Concedi il permesso di Registrazione schermo in Impostazioni di Sistema ▸ Privacy e sicurezza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contenu partageable trouvé. Autorisez l'enregistrement de l'écran dans Réglages Système ▸ Confidentialité et sécurité."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可共享的内容。请在「系统设置」▸「隐私与安全性」中授予屏幕录制权限。"
          }
        }
      }
    },
