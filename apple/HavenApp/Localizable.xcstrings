    "Shares a smaller copy by default and always strips location.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定で小さめのコピーを共有し、位置情報は常に削除します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt standardmäßig eine kleinere Kopie und entfernt immer den Standort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte una copia más pequeña de forma predeterminada y siempre elimina la ubicación."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 더 작은 사본을 공유하며, 위치 정보는 항상 제거합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, compartilha uma cópia menor e sempre remove a localização."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide una copia più piccola per impostazione predefinita e rimuove sempre la posizione."
          }
        },
        "fr": {
          "stringUnit": {
