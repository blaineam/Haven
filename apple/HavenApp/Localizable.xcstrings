    "Link your other devices — each gets its own revocable key, never your master key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの端末をリンクしましょう — それぞれに取り消し可能な専用の鍵が割り当てられ、マスター鍵が使われることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deine anderen Geräte — jedes erhält einen eigenen, widerrufbaren Schlüssel, nie deinen Hauptschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincula tus otros dispositivos — cada uno recibe su propia clave revocable, nunca tu clave maestra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기를 연결하세요 — 각 기기는 마스터 키가 아니라 취소할 수 있는 고유 키를 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincule seus outros dispositivos — cada um recebe a própria chave revogável, nunca sua chave mestra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega i tuoi altri dispositivi — ognuno riceve la propria chiave revocabile, mai la tua chiave principale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez vos autres appareils — chacun reçoit sa propre clé révocable, jamais votre clé maîtresse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联你的其他设备 —— 每台设备都有自己可撤销的密钥，绝不会用到你的主密钥。"
          }
        }
      }
    },
