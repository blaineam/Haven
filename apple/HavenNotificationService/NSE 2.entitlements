<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: read Haven notification-preview preference set by the main app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.blaineam.kith</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.blaineam.kith.shared</string>
	</array>
</dict>
</plist>
