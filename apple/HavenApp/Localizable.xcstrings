    "Show a code with **Settings → Devices → Link a device** on your primary device, then scan or paste it here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインのデバイスで **設定 → デバイス → デバイスをリンク** からコードを表示し、ここでスキャンするか貼り付けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dir auf deinem Hauptgerät unter **Einstellungen → Geräte → Gerät verknüpfen** einen Code anzeigen und scanne oder füge ihn hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un código con **Ajustes → Dispositivos → Vincular un dispositivo** en tu dispositivo principal y luego escanéalo o pégalo aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 기기에서 **설정 → 기기 → 기기 연결**로 코드를 표시한 다음, 여기에서 스캔하거나 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um código em **Ajustes → Dispositivos → Vincular dispositivo** no seu dispositivo principal e escaneie ou cole o código aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codice con **Impostazioni → Dispositivi → Collega un dispositivo** sul dispositivo principale, poi scansionalo o incollalo qui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un code avec **Réglages → Appareils → Associer un appareil** sur votre appareil principal, puis scannez-le ou collez-le ici."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主设备上打开 **设置 → 设备 → 关联设备** 显示配对码，然后在这里扫描或粘贴。"
          }
        }
      }
    },
