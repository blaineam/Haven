    "Frees space on this device only — posts re-download on demand. Kept items stay.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの空き容量だけを増やします。投稿は必要になったら再ダウンロードされます。保存した項目はそのまま残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt nur auf diesem Gerät Speicher frei — Beiträge werden bei Bedarf erneut geladen. Behaltene Inhalte bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio solo en este dispositivo — las publicaciones se vuelven a descargar cuando las necesites. Lo guardado se queda."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서만 공간을 확보해요. 게시물은 필요할 때 다시 다운로드되고, 보관한 항목은 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espaço apenas neste dispositivo — as publicações são baixadas de novo quando necessário. Os itens guardados permanecem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera spazio solo su questo dispositivo — i post vengono riscaricati all'occorrenza. Gli elementi conservati restano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère de l'espace sur cet appareil uniquement — les publications se retéléchargent à la demande. Les éléments conservés restent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅释放这台设备上的空间——帖子会按需重新下载，已保留的内容不受影响。"
          }
        }
      }
    },
