# Haven relay as a Linux systemd user service.
#
#   mkdir -p ~/.config/systemd/user
#   cp haven-relay.service ~/.config/systemd/user/
#   loginctl enable-linger "$USER"          # keep it running after you log out
#   systemctl --user daemon-reload
#   systemctl --user enable --now haven-relay
#   systemctl --user status haven-relay     # check it / read the node id from the log
#
# First-time only, attach to your circle once (saves the link), then start the service:
#   haven-relay run --link <code>           # Ctrl-C after it says "saved"
#
# Self-updating: under this unit the relay installs signed updates over ~/.local/bin/haven-relay
# (atomic rename, previous kept as haven-relay.prev) and exits with code 75; Restart=always brings
# it back on the new binary, which is rolled back automatically if it fails its health check.
# Channel: add `--auto-update rc|off` to ExecStart (default stable).
#
[Unit]
Description=Haven relay (always-on circle mailbox, ciphertext only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/haven-relay run
# ALWAYS (not on-failure): a self-update restart exits with code 75 and must come back.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
